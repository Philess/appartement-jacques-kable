---
import { config, property, released } from '../data/property';
const indicators = [
  { name: 'Énergie', kind: 'DPE', grade: property.energyClass, value: config.energyConsumption, unit: 'kWh/m²/an', colors: ['#25815b', '#54a95b', '#a6c965', '#e4cf67', '#d79c59', '#c27655', '#ae575b'] },
  { name: 'Climat', kind: 'GES', grade: property.climateClass, value: config.greenhouseEmissions, unit: 'kg CO₂/m²/an', colors: ['#d9eaf2', '#c6d5ea', '#b2bddf', '#9b9bc6', '#8782ae', '#776494', '#664878'] },
];
const foreground = (hex: string) => {
  const channels = hex.match(/[0-9a-f]{2}/gi)!.map((channel) => {
    const value = parseInt(channel, 16) / 255;
    return value <= .04045 ? value / 12.92 : ((value + .055) / 1.055) ** 2.4;
  });
  return channels[0] * .2126 + channels[1] * .7152 + channels[2] * .0722 > .179 ? '#000' : '#fff';
};
---
<div class="diagnostic" aria-labelledby="energy-title">
  <h3 id="energy-title">Énergie &amp; climat</h3>
  <div class="energy-labels">
    {indicators.map((indicator) => (
      <div class="energy-card">
        <p class="eyebrow">{indicator.name} · {indicator.kind}</p>
        <p class="energy-result">Classe <strong>{indicator.grade}</strong></p>
        <ol class="energy-scale" aria-label={`Échelle ${indicator.kind}, classe ${indicator.grade}`}>
          {['A', 'B', 'C', 'D', 'E', 'F', 'G'].map((grade, index) => (
            <li style={`--label-color:${indicator.colors[index]};--label-ink:${foreground(indicator.colors[index])};--label-width:${46 + index * 9}%`}
                class:list={{ selected: grade === indicator.grade }}
                aria-label={`${grade}${grade === indicator.grade ? ' : classe du bien' : ''}`}>
              <span>{grade}</span>{grade === indicator.grade && <b aria-hidden="true">←</b>}
            </li>
          ))}
        </ol>
        <p class="small">{indicator.value === null ? 'Valeur chiffrée à renseigner depuis le diagnostic.' : `${indicator.value} ${indicator.unit}`}</p>
      </div>
    ))}
  </div>
  <p>Dépenses annuelles d’énergie estimées pour un usage standard : <strong>{property.energyCost.min} à {new Intl.NumberFormat('fr-FR').format(property.energyCost.max)} €</strong>. Années de référence des prix de l’énergie : {property.energyCost.reference}, abonnements compris.</p>
  {!released && <p class="preview-note">Classes et estimation issues de l’annonce source. Le diagnostic réel et ses valeurs chiffrées doivent être confirmés avant publication.</p>}
</div>
